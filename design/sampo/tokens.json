    "autoplay-limit": { "$type": "duration", "$value": "5000ms", "$description": "WCAG 2.2.2: motion that starts on its own ends by here" },
    "reduced": {
      "$description": "prefers-reduced-motion: reduce (or data-motion=\"reduce\") drops every animation to none and shows the still: the hammer raised, the fire at rest, no sparks or glows. Colour and opacity changes of 150ms or less stay."
    }
  },
  "$extensions": {
    "sampo": {
      "pairs": [
        { "fg": "text", "bg": "surface", "min": 7 },
        { "fg": "text", "bg": "raised", "min": 7 },
        { "fg": "text", "bg": "sunken", "min": 7 },
        { "fg": "text-muted", "bg": "surface", "min": 4.5 },
