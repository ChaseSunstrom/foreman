  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["Bodoni Moda", "Didot", "Georgia", "serif"],
      "$description": "a high-contrast modern serif for the word and headlines, 420 at large optical size; the italic carries taglines. OFL; the logo files carry it outlined"
    },
    "text": {
      "$value": ["Archivo", "Helvetica Neue", "Arial", "sans-serif"],
      "$description": "a grotesque for reading, 400 and 600"
    },
    "mono": {
      "$value": ["Martian Mono", "Menlo", "Consolas", "monospace"],
      "$description": "wide and engraved: kickers, commands, numbers, labels; tabular figures"
    },
    "scale": {
      "$type": "number",
      "base": { "$value": 16, "$description": "px at 1rem" },
      "ratio": { "$value": 1.333, "$description": "perfect fourth" }
    }
  },
  "motion": {
    "$description": "The UI tokens are motion.md's; the mark's motion is the forge: the fire burns, the hammer strikes and throws sparks, the runes kindle and the rivets heat in turn, then it rests. Every autoplay ends within autoplay-limit and rests on the still; a loop runs only while work runs (the pane glyph) or under the pointer.",
    "duration": {
      "$type": "duration",
      "tap": { "$value": "90ms" },
      "small": { "$value": "150ms" },
      "enter": { "$value": "220ms" },
      "exit": { "$value": "150ms" },
      "move": { "$value": "300ms" },
      "stage": { "$value": "500ms", "$description": "the ceiling for anything interactive" },
      "rune": { "$value": "300ms", "$description": "one rune kindling; runes follow each other by this step" },
      "strike": { "$value": "2200ms", "$description": "one hammer blow: raised, wound up, struck, recovered" }
    },
    "easing": {
      "$type": "cubicBezier",
      "enter": { "$value": [0.05, 0.7, 0.1, 1] },
      "exit": { "$value": [0.3, 0, 0.8, 0.15] },
      "move": { "$value": [0.45, 0, 0.2, 1] },
      "strike": { "$value": [0.6, 0, 1, 0.6], "$description": "the hammer's fall: slow off the top, fastest at the face" },
      "spring": { "$value": [0.2, 0.9, 0.25, 1.05] },
      "spring-2": { "$value": [0.3, 1.4, 0.4, 1] },
      "forge-3": { "$value": [0.2, 0.7, 0.25, 1.0] },
      "forge-4": { "$value": [0.3, 0.7, 0.3, 1.0] },
      "forge-5": { "$value": [0.5, 0.0, 0.6, 1.0] },
      "forge-6": { "$value": [0.2, 0.7, 0.4, 1.0] },
      "forge-7": { "$value": [0.3, 0.0, 0.5, 1.0] },
      "forge-8": { "$value": [0.6, 0.0, 0.8, 0.4] },
      "forge-9": { "$value": [0.2, 0.8, 0.3, 1.0] },
      "forge-10": { "$value": [0.3, 0.0, 0.3, 1.0] },
      "forge-11": { "$value": [0.45, 0.0, 0.4, 1.0] },
      "forge-12": { "$value": [0.6, 0.0, 1.0, 0.6] },
      "forge-13": { "$value": [0.15, 0.7, 0.4, 1.0] },
      "spring": { "$value": [0.2, 0.9, 0.25, 1.05] },
      "spring-2": { "$value": [0.3, 1.4, 0.4, 1] },
      "forge-3": { "$value": [0.2, 0.7, 0.25, 1.0] },
      "forge-4": { "$value": [0.3, 0.7, 0.3, 1.0] },
      "forge-5": { "$value": [0.5, 0.0, 0.6, 1.0] },
      "forge-6": { "$value": [0.2, 0.7, 0.4, 1.0] },
      "forge-7": { "$value": [0.3, 0.0, 0.5, 1.0] },
