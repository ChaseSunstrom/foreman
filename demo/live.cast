[34.856, "o", "\u001b[H\u001b[2J                                                                              \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m                                                                                         \u001b[38;5;246m\u2715\u001b[39m\r\n\u001b[38;5;102m\u001b[49m\u2502\u001b[39m                                                                             \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;116m\u2722 Foreman\u001b[0m\u001b[38;5;145m\u001b[48;5;235m  foreman-18db58\u001b[38;5;103m   standard\u001b[39m                                          \u001b[38;5;111m\u2597\u2590\u259b\u2588\u2588\u2588\u259c\u258c   \u001b[39m\r\n\u001b[38;5;102m\u001b[49m\u251c\u2500 \u001b[1m\u001b[38;5;147m\u25f7\u001b[0m \u001b[1m\u001b[38;5;183m\u25c6 fm-scout\u001b[0m \u001b[38;5;188mFind fm lib stats\u001b[39m \u001b[38;5;140m\u2500\u2500\u2500\u2500\u2500\u001b[38;5;97m\u2500\u2500\u2500\u2500\u2500\u001b[38;5;96m\u2500\u2500\u2500\u001b[38;5;60m\u2500\u2500\u2500\u2500\u001b[38;5;240m\u2500\u2500\u001b[38;5;239m\u2500\u2500\u2500\u001b[38;5;237m\u2500\u2500\u001b[39m \u001b[38;5;145min the background\u001b[39m  \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;151m0 done today\u001b[0m\u001b[48;5;235m \u001b[38;5;80m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[39m \u001b[1m\u001b[38;5;188m1 left\u001b[0m\u001b[48;5;235m \u001b[38;5;116m 1 now\u001b[39m                       \u001b[38;5;111m \u259c\u2588\u2588\u2588\u2588\u2588\u259b\u2598  \u001b[39m\r\n\u001b[38;5;102m\u001b[49m\u2502\u001b[39m                                                                             \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103m\u2713 nothing needs you\u001b[39m                                                           \u