b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   recreated from T-0001 because its first check ran from the wrong directory.  \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m                                                                                \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   \u001b[38;5;216m\u270e\u001b[38;5;103m changed \u001b[38;5;116mplugin/lib/fmcli.py\u001b[38;5;103m \u2014 the follow-up is skipped if any file the \u001b[39m    \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   \u001b[38;5;103mtask touched is a test file.\u001b[39m                                                 \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   \u001b[38;5;216m\u270e\u001b[38;5;103m changed \u001b[38;5;116mplugin/tests/test_diagnosis.py\u001b[38;5;103m \u2014 new test that a touched test file\u001b[39m \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   \u001b[38;5;103mmeans no follow-up is captured.\u001b[39m                                              \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m                                                                                \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   \u001b[38;5;151m\u2713\u001b[39m new test\u001b[38;5;103m \u2192 fails without the change, passes with it\u001b[39m                        \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;151mClosed per day\u001b[0m\u001b[38;5;59m\u001b[48;5;235m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500    \u001b[1m\u001b[38;5;147mToday\u001b[0m\u001b[38;5;59m\u001b[48;5;235m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   \u001b[38;5;151m\u2713\u001b[39m cd plugin/tests && python3 -m unittest test_diagnosis\u001b[38;5;103m \u2192 6 tests OK\u001b[39m         \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;237m                                       \u001b[38;5;151m\u2588\u2588\u001b[39m    \u001b[1m\u001b[38;5;151m   6%   \u001b[38;5;147m   $0.00  \u001b[38;5;151m    13ms  \u001b[38;5;103m     \u2013    \u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m                                                                                \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;237m                                       \u001b[38;5;151m\u2588\u2588\u001b[39m     \u001b[38;5;114m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;111m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;114m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;114m\u001b[48;5;236m      \u001b[39m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   Finish printed a \"never failed in 3 runs\" warning about that command. It's   \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;237m                                       \u001b[38;5;151m\u2588\u2588\u001