38;5;237m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[38;5;66m\u25cb\u001b[38;5;237m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[38;5;66m\u25cb\u001b[39m                \u001b[38;5;73m\u2502\r\n\u001b[49m\u2502\u001b[39m   M tier.                                                 \u001b[38;5;73m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;73m\u001b[48;5;235m\u2502\u001b[39m \u001b[38;5;115mplan\u001b[38;5;103m         \u001b[38;5;115mready\u001b[38;5;103m         \u001b[1m\u001b[38;5;116mbuild\u001b[0m\u001b[38;5;103m\u001b[48;5;235m         verify          docs          audit        close\u001b[39m                \u001b[38;5;73m\u2502\r\n\u001b[49m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;73m\u001b[48;5;235m\u2502\u001b[39m \u001b[38;5;241m\u2501\u001b[38;5;243m\u2501\u001b[38;5;244m\u2501\u001b[38;5;237m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[39m \u001b[1m0/1\u001b[0m\u001b[48;5;235m \u001b[38;5;103m0%\u001b[39m                       \u001b[38;5;73m\u2502\r\n\u001b[38;5;103m\u001b[49m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250