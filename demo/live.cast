38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;103m\u001b[48;5;235m\u2502\u001b[39m \u001b[1m\u001b[38;5;103m\u258dNow\u001b[0m\u001b[48;5;235m                                                                                                     \u001b[38;5;103m\u2502\r\n\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m        self.assertIn(\"package-lock.json: a fixture \u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;103m\u001b[48;5;235m\u2502\u001b[39m \u001b[38;5;103midle \u00b7 last: Running sed -n 3585,3680p lib/fmcli.py \u00b7 1s ago\u001b[39m                                             \u001b[38;5;103m\u2502\r\n\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m        self.assertLess(len(out), len(diff))\u001b[39m          \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;103m\u001b[48;5;235m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    def test_a_plain_diff_is_unchanged(self):\u001b[39m         \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;103m\u001b[48;5;235m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2