[15.077, "o", "\u001b[H\u001b[2J\u001b[38;5;103m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m                                                                                     \u001b[38;5;246m\u2715\u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[1m\u001b[38;5;151m\u2713 \u001b[0m\u001b[38;5;116m\u276f Ran cd /tmp/fm-live-1792113935-dzk2t0jg/foreman/plugin && sed -n 855,910p \u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;116m\u273b Foreman\u001b[0m\u001b[38;5;103m\u001b[48;5;235m  foreman-8911da\u001b[39m                                                 \u001b[38;5;111m \u2597\u2590\u259b\u2588\u2588\u2588\u259c\u258c\u2596 \u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m   \u001b[38;5;116mlib/fmcli.py; grep -n \"def .*test_file\\|is_test\\|_is_test\" lib/*.py | head; \u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103m  standard\u001b[39m                                                                \u001b[38;5;111m  \u259c\u2588\u2588\u2588\u2588\u2588\u259b  \u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m   \u001b[38;5;116msed -n 40,70p tests/test_diagnosis.py\u001b[38;5;103m \u00b7 0.1s \u00b7 79 lines\u001b[39m                      \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103m\u2713 nothing needs you\u001b[39m                                                       \u001b[38;5;111m   \u2598\u2598 \u259d\u259d   \u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m        self.assertTrue(any(\"empty CSV\" in b.title for b in kids), [b.tit\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103mWorking, no task in focus\u001b[39m                                              \u001b[38;5;151m0 closed today\u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188mclass Ladder(Base):\u001b[39m                                                        \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103mNext  \u001b[39mqueue is empty: FINAL VERIFY and REFLECT (/foreman:next)\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    def test_the_next_rung_follows_failed_runs_and_open_hypotheses(self):\u001b[39m  \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;151m        self.fm(\"task\", \"new\", \"Fix flake\", \"--type\", \"FIX\", \"--tier\", \"S\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m                \"--focus\")\u001b[39m                                                 \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m        for _ in range(2):\u001b[39m                                                 \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m            self.fm(\"task\", \"evidence\", \"T-0001\", \"--step\", \"1\", \"--run\",\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m        self.assertIn(\"fm-debugger\", self.fm(\"next\").stdout)\u001b[39m               \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m        self.fm(\"task\", \"evidence\", \"T-0001\", \"--step\", \"1\", \"--run\", \"fa\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m        self.fm(\"task\", \"hypo\", \"T-0001\", \"add\", \"the cache is stale\", \"-\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m        self.fm(\"task\", \"hypo\", \"T-0001\", \"add\", \"the clock skews\", \"--pr\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m        self.assertIn(\"differential\", self.fm(\"next\").stdout)\u001b[39m              \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;103m  \u2514 \u2026 67 more lines\u001b[39m                                                            \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500