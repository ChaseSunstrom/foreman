[18.598, "o", "\u001b[H\u001b[2J\u001b[38;5;103m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    mine = set(c.task_touches(p, b.id))\u001b[39m                                    \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m                                                                                     \u001b[38;5;246m\u2715\u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    first = next((i for i, e in enumerate(events) if e.get(\"event\") == \"f\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;116m\u2736 Foreman\u001b[0m\u001b[38;5;103m\u001b[48;5;235m  foreman-8911da\u001b[39m                                                 \u001b[38;5;111m  \u2590\u259b\u2588\u2588\u2588\u259c\u258c  \u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    since = str(b.meta.get(\"created\") or \"\")  # ledger order when its foc\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103m  standard\u001b[39m                                                                \u001b[38;5;111m \u259d\u259c\u2588\u2588\u2588\u2588\u2588\u259b\u2598 \u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    others = {os.path.relpath(f, p.root) for i, e in enumerate(events)\u001b[39m     \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103m\u2713 nothing needs you\u001b[39m                                                       \u001b[38;5;111m   \u2598\u2598 \u259d\u259d   \u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m              if e.get(\"event\") == \"touched\" and e.get(\"task\") not in (No\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;