d in 3 runs\" warning about that command. It's   \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;237m                                       \u001b[38;5;151m\u2588\u2588\u001b[39m     \u001b[38;5;114m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;111m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;114m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;114m\u001b[48;5;236m      \u001b[39m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   the whole file, so it was expected, and the red/green check above covers the \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;237m                                       \u001b[38;5;151m\u2588\u2588\u001b[39m     \u001b[38;5;114m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;111m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;114m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;114m\u001b[48;5;236m      \u001b[39m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   new test.                                                                    \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;237m                                       \u001b[38;5;151m\u2588\u2588\u001b[39m     \u001b[38;5;114m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;111m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;114m\u001b[48;5;236m      \u001b[38;5;237m\u001b[48;5;235m    \u001b[38;5;114m\u001b[48;5;236m      \u001b[39m\u001b[48;5;235m\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m                                                                                \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;237m                                       \u001b[38;