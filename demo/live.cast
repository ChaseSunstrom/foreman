[41.377, "o", "\u001b[H\u001b[2J                                                                              \u001b[2m\u001b[48;2;38;38;38m\u2502\u001b[0m\u001b[48;2;38;38;38m                                                                                         \u001b[38;2;153;153;153m\u2715\u001b[39m\r\n\u001b[49m\u25cf Ran \u001b[1m3\u001b[0m stop hooks                                                            \u001b[2m\u001b[48;2;38;38;38m\u2502\u001b[0m\u001b[48;2;38;38;38m \u001b[1m\u001b[38;2;95;215;215m\u2733 Foreman\u001b[0m\u001b[38;2;154;163;176m\u001b[48;2;38;38;38m  foreman-8806de\u001b[38;2;108;118;134m   standard\u001b[39m                                          \u001b[38;2;79;157;255m\u2597\u2590\u259b\u2588\u2588\u2588\u259c\u258c   \u001b[39m\r\n\u001b[49m  \u001b[38;2;153;153;153m\u23bf \u00a0\u001b[39mStop hook error: Foreman drive: background work is still running         \u001b[2m\u001b[48;2;38;38;38m\u2502\u001b[0m\u001b[48;2;38;38;38m \u001b[1m\u001b[38;2;135;215;135m0 done today\u001b[0m\u001b[48;2;38;38;38m \u001b[38;2;102;221;221m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[39m \u001b[1m\u001b[38;2;208;213;221m1 left\u001b[0m\u001b[48;2;38;38;38m \u001b[38;2;95;215;215m 1 now\u001b[39m                       \u001b[38;2;79;157;255m \u259c\u2588\u2588\u2588\u2588\u2588\u259b\u2598  \u001b[39m\r\n\u001b[49m  (a5de58d00ef94116d, bwmja606d); its notification wakes you, so don't        \u001b[2m\u001b[48;2;38;38;38m\u2502\u001b[0m\u001b[48;2;38;38;38m \u001b[38;2;108;118;134m\u2713 nothing needs you\u001b[39m                                                           \u001b[38;2;79;157;255m  \u2598\u2598 \u259d\u259d    \u001b[39m\r\n\u001b[49m  sleep or poll. Meanwhile do what doesn't need its result: the next          \u001b[2m\u001b[48;2;38;38;38m\u2502\u001b[0m\u001b[48;2;38;38;38m \u001b[1m\u001b[38;2;255;107;