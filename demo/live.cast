[265.933, "o", "\u001b[H\u001b[2J\u001b[38;5;103m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m----------------------------------------------------\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m                                                                                                          \u001b[38;5;246m\u2715\u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188mRan 116 tests in 60.475s\u001b[39m                              \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;73m\u001b[48;5;235m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;210mFAILED (failures=1)\u001b[39m                                   \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;73m\u001b[48;5;235m\u2502\u001b[39m \u001b[1m\u001b[38;5;116m\u2733 Foreman\u001b[0m\u001b[48;5;235m \u001b[38;5;103mforeman-7a1286\u001b[39m                                                                                 \u001b[38;5;73m\u2502\r\n\u001b[38;5;103m\u001b[49m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2