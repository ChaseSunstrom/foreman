[18.095, "o", "\u001b[H\u001b[2J\u001b[38;5;103m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    this task's start snapshot couldn't be re-based past it (both changed\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m                                                                                     \u001b[38;5;246m\u2715\u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    this task's first focus, not its capture: edits made before it starte\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;116m\u2722 Foreman\u001b[0m\u001b[38;5;103m\u001b[48;5;235m  foreman-8911da\u001b[39m                                                 \u001b[38;5;111m  \u2590\u259b\u2588\u2588\u2588\u259c\u258c  \u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    events = c.ledger_tail(p, c.TASK_WINDOW)\u001b[39m                               \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103m  standard\u001b[39m                                                                \u001b[38;5;111m \u259d\u259c\u2588\u2588\u2588\u2588\u2588\u259b\u2598 \u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    mine = set(c.task_touches(p, b.id))\u001b[39m                                    \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103m\u2713 nothing needs you\u001b[39m                                                       \u001b[38;5;111m   \u259d\u259d \u2598\u2598   \u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188m    first = next((i for i, e in enumerate(events) if e.get(\"event\") == \"f\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u25