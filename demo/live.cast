;5;103mforeman-7a1286\u001b[39m                                                                                 \u001b[38;5;103m\u2502\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   limit.                                                  \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;103m\u001b[48;5;235m\u2502\u001b[39m \u001b[38;5;103mstandard\u001b[39m \u001b[38;5;103m\u00b7 drive on\u001b[39m                                                                                      \u001b[38;5;103m\u2502\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m                                                           \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;103m\u001b[48;5;235m\u2502\u001b[39m \u001b[38;5;103mNothing active\u001b[39m                                                                               \u001b[38;5;111m\u2597\u2590\u259b\u2588\u2588\u2588\u259c\u258c\u2596  \u001b[39m \u001b[38;5;103m\u2502\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   Changed: \u001b[38;5;153mplugin/lib/fmcli.py\u001b[39m: new \u001b[38;5;153mREAD_PARTS = 1500\u001b[39m.    \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;103m\u001b[48;5;235m\u2502\u001b[39m \u001b[38;5;151m\u2713 1\u001b[38;5;103m today \u00b7 0 queued \u00b7 0 in inbox\u001b[39m                                                            \u001b[38;5;111m \u259c\u2588\u2588\u2588\u2588\u2588\u259b   \u001b[39m \u001b[38;5;103m\u2502\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   The \"N lines\" in the brief now uses the compacted       \u001b[38;5;116m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[38;5;103m\u001b[48;5;235m\u2502\u001b[39m \u001b[38;5;103m\u2192 queue is empty: FINAL VERIFY and REFLECT (/foreman:next)\u001b[39m                                   \u001b[38;5;111m  \u2598\u2598 \u259d\u259d    \u001b[39m \u001b[38;5;103m\u2502\r\n\u001b[38;5;116m\u001b[49m\u2502\u001b[39m   co