[44.915, "o", "\u001b[H\u001b[2J  \u001b[38;5;246m\u23bf \u00a0\u001b[39mStop hook error: Foreman drive: background work is still running         \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m                                                                                         \u001b[38;5;246m\u2715\u001b[39m\r\n\u001b[49m  (a37ef10b61f552285, bps9ffg55); its notification wakes you, so don't        \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;116m\u2733 Foreman\u001b[0m\u001b[38;5;145m\u001b[48;5;235m  foreman-18db58\u001b[38;5;103m   standard\u001b[39m                                          \u001b[38;5;111m \u2597\u2590\u259b\u2588\u2588\u2588\u259c\u258c\u2596 \u001b[39m\r\n\u001b[49m  sleep or poll. Meanwhile do what doesn't need its result: the next          \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;151m0 done today\u001b[0m\u001b[48;5;235m \u001b[38;5;80m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[39m \u001b[1m\u001b[38;5;188m1 left\u001b[0m\u001b[48;5;235m \u001b[38;5;116m 1 now\u001b[39m                       \u001b[38;5;111m  \u259c\u2588\u2588\u2588\u2588\u2588\u259b  \u001b[39m\r\n\u001b[49m  step's test, the audit lenses on the current diff (fm audit prep),          \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103m\u2713 nothing needs you\u001b[39m                                                           \u001b[38;5;111m   \u2598\u2598 \u259d\u259d   \u001b[39m\r\n\u001b[49m  docs, planning what comes after this task. If nothing is independent        \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;147mFEATURE\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;116mT-0001\u001b[0m\u001b[48;5;235m \u001b[38;5;145msmall\u001b[39m                                                     \u001b[38;5;145m0/1 proved   28s\u001b[39m\r\n\u001b[49m  of it, end the turn with one line naming what you wait on.                  \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1mfm lib stats --days N\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;102m\u001b[49m\u2502\u001b[39m                                                                             \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;80m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[38;5;237m \u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[39m  \u001b[38;5;145m0 of 2 steps done \u00b7 2 left\u001b[39m\r\n\u001b[38;5;102m\u001b[49m\u251c\u2500 \u001b[1m\u001b[38;5;116m\u25cf\u001b[0m \u001b[1m\u001b[38;5;116mClaude\u001b[0m \u001b[38;5;73m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[38;5;67m\u2500\u001b[38;5;66m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[38;5;60m\u2500\u2500\u001b[38;5;240m\u2500\u2500\u2500\u2500\u2500\u001b[38;5;239m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[38;5;238m\u2500\u2500\u2500\u2500\u001b[38;5;237m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m  \u001b[2m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;114m\u25cf\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u25cf\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[38;5;159m\u25c9\u001b[38;5;238m\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u001b[38;5;66m\u2501\u2501\u001b[38;5;80m\u2501\u001b[38;5;238m\u2501\u2501\u2501\u001b[38;5;66m\u25cb\u001b[38;5;237m\u2500\u2500\u2500\u2500\u2500\u25