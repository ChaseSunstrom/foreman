[13.57, "o", "\u001b[H\u001b[2J\u001b[38;5;147m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m                                                                                     \u001b[38;5;246m\u2715\u001b[39m\r\n\u001b[38;5;147m\u001b[49m\u2502\u001b[39m \u001b[1m\u001b[38;5;147m\u276f \u001b[0mFEATURE: fm task finish --why-not-caught skips its 'catch it earlier'        \u001b[38;5;147m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[1m\u001b[38;5;116m\u2733 Foreman\u001b[0m\u001b[38;5;103m\u001b[48;5;235m  foreman-8911da\u001b[39m                                                 \u001b[38;5;111m  \u2590\u259b\u2588\u2588\u2588\u259c\u258c  \u001b[39m\r\n\u001b[38;5;147m\u001b[49m\u2502\u001b[39m   follow-up when the task's diff already changed a test file                   \u001b[38;5;147m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103m  standard\u001b[39m                                                                \u001b[38;5;111m \u259d\u259c\u2588\u2588\u2588\u2588\u2588\u259b\u2598 \u001b[39m\r\n\u001b[38;5;147m\u001b[49m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103m\u2713 nothing needs you\u001b[39m                                                       \u001b[38;5;111m   \u2598\u2598 \u259d\u259d   \u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103mWorking, no task in focus\u001b[39m                                              \u001b[38;5;151m0 closed today\u001b[39m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[1m\u001b[38;5;151m\u2713 \u001b[0m\u001b[38;5;116m\u276f Ran grep -rn \"why.not.caught\\|why_not_caught\" --include=* -I . 2>/dev/null\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m \u001b[38;5;103mNext  \u001b[39mqueue is empty: FINAL VERIFY and REFLECT (/foreman:next)\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m   \u001b[38;5;116m| grep -v \"^./.git/\" | head -30\u001b[38;5;103m \u00b7 0.1s \u00b7 13 lines\u001b[39m                            \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[38;5;103m\u001b[49m\u2502\u001b[39m \u001b[38;5;59m  \u2502 \u001b[38;5;188mplugin/tests/test_diagnosis.py:52:        self.assertIn(\"why-not-caught\",\u2026\u001b[39m \u001b[38;5;103m\u2502\u001b[2m\u001b[39m\u001b[48;5;235m\u2502\u001b[0m\u001b[48;5;235m\r\n\u001b[3