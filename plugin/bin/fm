#!/usr/bin/env python3
"""fm: Sampo's state CLI. See `fm --help` and MASTER.md."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
try:  # T-0368: below Python 3.12.7, re-run under a supported one
    from sampo import py  # noqa: E402
    py.lane_reexec(__file__)  # T-2843: inside a lane, run the lane's own plugin
    py.reexec()
except Exception:
    pass
from sampo import cli  # noqa: E402

try:
    code = cli.main()
    sys.stdout.flush()
except BrokenPipeError:  # T-0825: the reader quit (fm … | head): end quietly, not with Python's flush complaint
    os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    code = 141  # T-0839: as a shell reports SIGPIPE; a command cut short mid-change must not read as success
sys.exit(code)
