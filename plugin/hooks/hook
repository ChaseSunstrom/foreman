#!/usr/bin/env python3
"""Sampo hook dispatcher (PROTECTED CORE): `hook <Event>` with the event JSON on stdin; `hook --agent X <Event>`
for another coding agent's event (fmagents reads it into Claude Code's shape and answers in X's format).

One entry point per event (see hooks.json). Non-guard failures exit 0; the PreToolUse guard fails closed.
"""
import os
import sys

ARGV = sys.argv[1:]
AGENT = ARGV[1] if ARGV[:1] == ["--agent"] and len(ARGV) > 1 else None  # T-0324: Codex, Gemini CLI, opencode
EVENT = ((ARGV[2:] if AGENT else ARGV) or [""])[0]
TOOL_EVENT = EVENT in ("PreToolUse", "BeforeTool")
PLUGIN = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
LIB = os.path.join(PLUGIN, "lib")
sys.path.insert(0, LIB)
STDIN = None
def _temp_path(path):
    import tempfile
    return os.path.realpath(path).startswith(os.path.realpath(tempfile.gettempdir()) + os.sep)


if os.environ.get("SAMPO_HOOK_MODULES") and _temp_path(os.environ["SAMPO_HOOK_MODULES"]):  # T-3139: the bench asks
    import atexit  # which plugin files this process imported (only into a temp-dir file)

    def _dump_modules(out=os.environ["SAMPO_HOOK_MODULES"]):
        try:
            top = os.path.dirname(PLUGIN) + os.sep
            files = sorted({f[len(top):] for f in (getattr(m, "__file__", None) for m in list(sys.modules.values()))
                            if isinstance(f, str) and f.startswith(PLUGIN + os.sep)})
            with open(out, "a", encoding="utf-8") as fh:
                fh.write(__import__("json").dumps(files) + "\n")
        except Exception:
            pass
    atexit.register(_dump_modules)
try:  # T-0368: below Python 3.12.7, run this hook under a supported Python. A child, not exec: only its answer (exit 0
    from sampo import py  # or 2) is relayed; if it crashes, the hook runs here as before, so a broken interpreter never opens
    _exe = py.target(sys.version_info)  # the guard (Claude Code reads exit 1 as allow)
    if _exe:
        import subprocess
        STDIN = sys.stdin.buffer.read()
        _r = subprocess.run([_exe, os.path.realpath(__file__), *ARGV], input=STDIN, capture_output=True, timeout=120,
                            env=dict(os.environ, FOREMAN_PY_CHILD="1"))
        if _r.returncode in (0, 2):
            sys.stdout.buffer.write(_r.stdout)
            sys.stderr.buffer.write(_r.stderr)
            sys.stdout.flush()
            sys.stderr.flush()
            os._exit(_r.returncode)
except Exception:
    pass
try:  # T-3584: regex programs kept across hook calls (each is a new process); every doubt compiles as re would
    py.keep_regexes(EVENT)
except Exception:
    pass


def committed_library():
    """Load Sampo's library as last committed (git HEAD of Sampo's own repo, plugin/ at its top; GIT_* variables
    ignored) into sys.modules, for when the working copy can't be imported: a half-applied edit must not block every
    tool call, and the committed guard still decides. False when there is no committed copy."""
    import subprocess
    import types
    root = os.path.dirname(PLUGIN)
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}

    def git(*args):
        r = subprocess.run(["git", "-C", root, *args], capture_output=True, text=True, timeout=5, env=env)
        return r.stdout if r.returncode == 0 else None
    try:
        if os.path.realpath((git("rev-parse", "--show-toplevel") or "").strip() or "/nonexistent") != \
                os.path.realpath(root):
            return False
        names = [os.path.basename(n)[:-3] for n in (git("ls-tree", "--name-only", "HEAD", "plugin/lib/sampo/") or "").split()
                 if n.endswith(".py") and os.path.basename(n) != "__init__.py"]
        if not {"core", "hooks"} <= set(names) or git("cat-file", "-e", "HEAD:plugin/lib/fmguard.py") is None:
            return False
        # T-2781: every sampo.* and fmguard import resolves to HEAD source through a finder, in normal import order,
        # with an empty package __path__: a sibling never falls back to the working tree, and a name HEAD lacks raises
        import importlib.abc
        import importlib.util

        class HeadFinder(importlib.abc.MetaPathFinder, importlib.abc.Loader):
            def find_spec(self, fullname, path=None, target=None):
                if fullname == "sampo":
                    return importlib.util.spec_from_loader(fullname, self, is_package=True)
                if fullname == "fmguard" or (fullname.startswith("sampo.") and fullname[6:] in names):
                    return importlib.util.spec_from_loader(fullname, self)
                if fullname.startswith("sampo."):
                    raise ImportError(f"{fullname} is not in the committed library")

            def exec_module(self, mod):
                rel = "lib/fmguard.py" if mod.__name__ == "fmguard" else f"lib/sampo/{mod.__name__[6:]}.py"
                if mod.__name__ == "sampo":
                    mod.__path__ = []
                    return
                src = git("show", f"HEAD:plugin/{rel}")
                if src is None:
                    raise ImportError(f"{rel} is not in HEAD")
                mod.__file__ = os.path.join(PLUGIN, rel)
                exec(compile(src, f"HEAD:plugin/{rel}", "exec"), mod.__dict__)

        for k in [k for k in sys.modules if k == "sampo" or k.startswith("sampo.") or k == "fmguard"]:
            del sys.modules[k]  # stale working-tree entries from the failed import
        sys.meta_path.insert(0, HeadFinder())
        import importlib
        importlib.invalidate_caches()
        for m in ("sampo.core", "fmguard", "sampo.hooks"):
            importlib.import_module(m)
        return True
    except Exception:
        return False


try:
    from sampo import hooks
    if AGENT:
        from sampo import agents
except Exception as exc:  # broken install: never block unless this is the guard
    # T-2532: every event runs as last committed (Stop, SessionStart and the rest too, not silently off)
    if not committed_library():
        if not TOOL_EVENT:
            print(f"Sampo {EVENT} hook skipped: its library failed to import ({exc!r}) and no committed copy loaded",
                  file=sys.stderr)
            sys.exit(0)
        print(f"Sampo guard unavailable ({exc!r}); the tool call was blocked (fail-closed). "
              "Fix the plugin or run: claude plugin disable foreman@foreman", file=sys.stderr)
        sys.exit(2)
    from sampo import hooks
    if AGENT:
        try:
            from sampo import agents
        except Exception:  # no committed adapter either: refuse in the way every agent reads as a block
            if not TOOL_EVENT:
                sys.exit(0)
            print(f"Sampo guard unavailable ({exc!r}); the tool call was blocked (fail-closed)", file=sys.stderr)
            sys.exit(2)
    hooks.log_error(EVENT, f"the working copy of Sampo's library failed to import ({exc!r}); using the "
                             f"committed library (fix plugin/lib)")
_data = STDIN.decode("utf-8", "replace") if STDIN is not None else sys.stdin.read()
sys.exit(agents.hook(AGENT, EVENT, _data) if AGENT else hooks.run(EVENT, _data))
