[
  {"name": "outlines classes, methods, a setter, nested and async functions",
   "files": {"app.py": "\"\"\"Shop totals.\"\"\"\nimport os\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass Item:\n    \"\"\"One line on a bill.\"\"\"\n    name: str\n    price: float\n\n    @property\n    def cents(self):\n        return round(self.price * 100)\n\n    @cents.setter\n    def cents(self, v):\n        self.price = v / 100\n\n\ndef total(items, tax=0.0) -> float:\n    \"\"\"Sum with tax.\"\"\"\n    def line(i):\n        return i.price\n    return sum(line(i) for i in items) * (1 + tax)\n\n\nasync def fetch(url):\n    return url\n"},
   "inputs": {"path": "app.py"}, "expect": "facts",
   "facts_has": ["\"lines\": 29", "\"doc\": \"Shop totals.\"", "{\"line\": 3, \"text\": \"from dataclasses import dataclass\"}",
                 "{\"name\": \"Item\", \"kind\": \"class\", \"line\": 7, \"end_line\": 18, \"signature\": \"class Item\", \"decorators\": [\"dataclass\"], \"doc\": \"One line on a bill.\"}",
                 "{\"name\": \"Item.cents\", \"kind\": \"method\", \"line\": 13, \"end_line\": 14",
                 "{\"name\": \"Item.cents\", \"kind\": \"method\", \"line\": 17, \"end_line\": 18, \"signature\": \"def cents(self, v)\", \"decorators\": [\"cents.setter\"]",
                 "{\"name\": \"total\", \"kind\": \"function\", \"line\": 21, \"end_line\": 25, \"signature\": \"def total(items, tax=0.0) -> float\"",
                 "{\"name\": \"total.line\", \"kind\": \"function\", \"line\": 23",
                 "\"signature\": \"async def fetch(url)\""]},
  {"name": "a symbol narrows the outline to it and what it holds",
   "files": {"app.py": "class A:\n    def run(self):\n        pass\n\n\nclass B:\n    def run(self):\n        pass\n"},
   "inputs": {"path": "app.py", "symbol": "B"}, "expect": "facts",
   "facts_has": ["\"name\": \"B.run\", \"kind\": \"method\", \"line\": 7"], "facts_lacks": ["\"A.run\"", "\"name\": \"A\""]},
  {"name": "known-bad input: a misspelt path names the file it meant",
   "files": {"app.py": "def f():\n    pass\n"},
   "inputs": {"path": "ap.py"}, "expect": "bad_input", "error_has": ["did you mean 'app.py'"]},
  {"name": "known-bad input: a symbol that isn't there names the nearest one",
   "files": {"app.py": "class Item:\n    def cents(self):\n        pass\n"},
   "inputs": {"path": "app.py", "symbol": "Item.cent"}, "expect": "generator_failed", "error_has": ["did you mean 'Item.cents'"]},
  {"name": "plausible but wrong: a method's line points at its decorator",
   "files": {"app.py": "class Item:\n    @property\n    def cents(self):\n        return 1\n"},
   "inputs": {"path": "app.py"}, "expect": "checker_failed", "error_has": ["line 2"],
   "inject_facts": {"path": "app.py", "lines": 4, "doc": "", "imports": [], "symbols": [
     {"name": "Item", "kind": "class", "line": 1, "end_line": 4, "signature": "class Item", "decorators": [], "doc": ""},
     {"name": "Item.cents", "kind": "method", "line": 2, "end_line": 4, "signature": "def cents(self)", "decorators": ["property"], "doc": ""}]}},
  {"name": "plausible but wrong: a property's setter is left out",
   "files": {"app.py": "class Item:\n    @property\n    def cents(self):\n        return 1\n\n    @cents.setter\n    def cents(self, v):\n        pass\n"},
   "inputs": {"path": "app.py"}, "expect": "checker_failed", "error_has": ["cents", "line 7"],
   "inject_facts": {"path": "app.py", "lines": 8, "doc": "", "imports": [], "symbols": [
     {"name": "Item", "kind": "class", "line": 1, "end_line": 8, "signature": "class Item", "decorators": [], "doc": ""},
     {"name": "Item.cents", "kind": "method", "line": 3, "end_line": 4, "signature": "def cents(self)", "decorators": ["property"], "doc": ""}]}}
]
