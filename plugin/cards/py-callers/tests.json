  {"name": "calls in two files, a method call, a decorator, an import and a reference",
   "files": {"app.py": "def total(items):\n    return sum(i.cents for i in items)\n\n\nclass Cart:\n    def total(self):\n        return total(self.items)\n\n    def show(self):\n        return f\"{self.total():.2f}\"\n",
