{
  "title": "Claude Code (Foreman)",
  "uid": "foreman-claude-code",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "tags": [
    "claude-code",
    "foreman"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "influxdb",
        "label": "InfluxDB (Flux)"
      },
      {
        "name": "bucket",
        "type": "textbox",
        "query": "claude",
        "current": {
          "text": "claude",
          "value": "claude"
        },
        "label": "Bucket"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cost (USD) by model",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.source == \"claude-code\" and r._field =~ /claude_code_cost_usage/)\n  |> group(columns: [\"model\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens by type",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.source == \"claude-code\" and r._field =~ /claude_code_token_usage/)\n  |> group(columns: [\"type\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Lines of code by type",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.source == \"claude-code\" and r._field =~ /claude_code_lines_of_code/)\n  |> group(columns: [\"type\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Commits and pull requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.source == \"claude-code\" and r._field =~ /claude_code_(commit|pull_request)_count/)\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active time (s) by type",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.source == \"claude-code\" and r._field =~ /claude_code_active_time/)\n  |> group(columns: [\"type\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Edit tool decisions",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.source == \"claude-code\" and r._field =~ /claude_code_code_edit_tool_decision/)\n  |> group(columns: [\"decision\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          }
        }
      ]
    }
  ]
}
